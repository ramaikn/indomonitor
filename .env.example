# Diisi otomatis oleh scripts/start-database.ps1, jangan commit .env asli.
DATABASE_URL=postgresql://media_owner:CHANGE_ME@127.0.0.1:55432/media_intelligence
JDBC_DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/media_intelligence
DB_USER=media_api
DB_PASSWORD=CHANGE_ME
MIGRATION_USER=media_owner
MIGRATION_PASSWORD=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS
LOCAL_PG_PASSWORD=CHANGE_ME

# Asisten. Kunci hanya dibaca backend; model dan endpoint bisa diganti.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=ag/gemini-3.8-flash-low
# Isi SEARCH_MODEL sesuai ID penyedia pada /v1/models/web setelah dikonfigurasi.
SEARCH_BASE_URL=http://127.0.0.1:20128/v1
SEARCH_API_KEY=
SEARCH_MODEL=
FRONTEND_ORIGIN=http://127.0.0.1:5173
